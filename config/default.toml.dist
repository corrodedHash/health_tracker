# ── health-tracker configuration template ────────────────────────────────────
# Copy to config/default.toml or config/local.toml and fill in your values.
# Sensitive values (secrets, tokens) should instead be set via environment
# variables — they override whatever is in the TOML files.
#
# Both binaries also read $CWD/config/default.toml and $CWD/config/local.toml
# (local overrides the default; env vars override both).
#
#
# ── health-web (web server) ──────────────────────────────────────────────────
# The web binary reads env vars only (no TOML). Prefix: HEALTH__, separator: __
#
#   HEALTH__DATABASE_URL            Required   Postgres connection string
#   HEALTH__COOKIE_KEY              Required   Hex-encoded 64-byte key
#                                            (generate: openssl rand -hex 64)
#   HEALTH__LISTEN_ADDR             Optional   Default "0.0.0.0:3000"
#   HEALTH__STATIC_DIR              Optional   Path to pre-built frontend dist/
#   HEALTH__FRONTEND_URL            Optional   Frontend origin for CORS/redirects
#   HEALTH__COOKIE_SECURE           Optional   Default "true" (set "false" for HTTP)
#   HEALTH__DEV_AUTO_LOGIN          Optional   Default "false" — dev-only
#
#   # OIDC — optional, set all four or none:
#   HEALTH__OIDC__ISSUER_URL                  OIDC provider issuer URL
#   HEALTH__OIDC__CLIENT_ID                   OIDC client ID
#   HEALTH__OIDC__CLIENT_SECRET               OIDC client secret
#   HEALTH__OIDC__REDIRECT_URI                OIDC callback URL
#
# Example (export in your shell / systemd unit / Kubernetes Secret):
#
#   export HEALTH__DATABASE_URL="postgres://user:pass@db.example.com:5432/health"
#   export HEALTH__COOKIE_KEY="$(openssl rand -hex 64)"
#   export HEALTH__LISTEN_ADDR="0.0.0.0:3000"
#   export HEALTH__STATIC_DIR="/opt/health-tracker/frontend/dist"
#   export HEALTH__FRONTEND_URL="https://health.example.com"
#   export HEALTH__COOKIE_SECURE="true"
#   export HEALTH__OIDC__ISSUER_URL="https://accounts.example.com/realms/health"
#   export HEALTH__OIDC__CLIENT_ID="health-tracker"
#   export HEALTH__OIDC__CLIENT_SECRET="s3cr3t"
#   export HEALTH__OIDC__REDIRECT_URI="https://health.example.com/api/auth/callback"
#
#   export RUST_LOG="health_web=info,axum=warn"
#   exec health-web
#
#
# ── health-bot (Matrix bot) ──────────────────────────────────────────────────
# Reads config/default.toml → config/local.toml → HEALTH_* env vars (highest).
# Env prefix: HEALTH_, nesting separator: __
# Unlike the web server, the prefix is HEALTH_ (single underscore, no double).
#
#   ENV VAR                        TOML KEY              Required  Description
#   ─────────────────────────────────────────────────────────────────────────────
#   HEALTH_MATRIX__HOMESERVER      matrix.homeserver     No        Default "https://matrix.org"
#   HEALTH_MATRIX__USER_ID         matrix.user_id        Yes       Bot Matrix user ID
#   HEALTH_MATRIX__PASSWORD        matrix.password       Yes       Bot password
#   HEALTH_MATRIX__SESSION_FILE    matrix.session_file   No        Default "session.toml"
#   HEALTH_API__BASE_URL           api.base_url          No        Default "http://localhost:3000"
#   HEALTH_API__TOKEN              api.token             Yes       Bearer token for health-web API
#
# ── Example: config/default.toml ──────────────────────────────────────────────
#
# [matrix]
# homeserver = "https://matrix.example.com"
# user_id = "@health-bot:matrix.example.com"
# password = "matrix-bot-password"
# session_file = "session.toml"
#
# [api]
# base_url = "https://health.example.com"
# token = "ht-api-token"
#
# ── Or use env vars instead (overrides TOML): ─────────────────────────────────
#
#   export HEALTH_MATRIX__HOMESERVER="https://matrix.example.com"
#   export HEALTH_MATRIX__USER_ID="@health-bot:matrix.example.com"
#   export HEALTH_MATRIX__PASSWORD="matrix-bot-password"
#   export HEALTH_MATRIX__SESSION_FILE="session.toml"
#   export HEALTH_API__BASE_URL="https://health.example.com"
#   export HEALTH_API__TOKEN="ht-api-token"
#
#   export RUST_LOG="health_bot=info"
#   exec health-bot
